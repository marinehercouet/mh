    <section id="about">
      <h2>About</h2>
      <p>
        Write your about section here.  
        You can add images, links, lists, or additional blocks of content.
      </p>

      <img src="assets/example.jpg" alt="Example image" class="responsive-image" />
    </section>

    <section id="contact">
      <h2>Contact</h2>
      <p>
        You can add your email here:  
        <a href="mailto:you@example.com">you@example.com</a>
      </p>
    </section>
  </main>

  <footer>
    <p>© 2025 Your Name</p>
  </footer>

